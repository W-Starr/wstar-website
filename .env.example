# ==============================================================================
# WSTAR WEB & OPERATING SYSTEM — ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# Configure these variables in Vercel (Project Settings > Environment Variables)
# for production deployment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Sanity Cloud Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=qx20j59l
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-03-01

# Server-side write token for WSTAR OS sync, mutations, and the Newsroom Studio
# at /publications/admin (Keep Secret!).
# IMPORTANT: this must be an EDITOR-scoped token. A read/viewer token still lets
# pages load and list content, then fails every save with "Insufficient
# permissions". Create one at sanity.io/manage -> API -> Tokens -> role: Editor.
SANITY_API_WRITE_TOKEN=your_sanity_api_write_token_here

# ------------------------------------------------------------------------------
# 2. Google Gemini AI Engine
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 3. WSTAR OS Authentication & Sessions
# ------------------------------------------------------------------------------
# High-entropy random secret (32+ characters) used to sign session JWT tokens
# Generate one with: openssl rand -base64 32
AUTH_SECRET=your_strong_random_jwt_secret_here

# Founder Login Passwords (Must be set in Vercel and local development).
# These unlock BOTH the WSTAR OS at /os/login and the password-gated Newsroom
# Studio at /publications/admin, where publications are posted to the public
# /publications page. Either password works for the studio.
FOUNDER_PASSWORD_ABDULAZIZ=your_secure_password_for_abdulaziz
FOUNDER_PASSWORD_IBRAHIM=your_secure_password_for_ibrahim

# ------------------------------------------------------------------------------
# 4. Optional Integrations (Drive Sync & Firebase Feedback)
# ------------------------------------------------------------------------------
# Minified Google Service Account JSON string for Google Drive sync
# GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}

# Minified Firebase Service Account JSON string for Ace Acad feedback fetch
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}

# ------------------------------------------------------------------------------
# 5. Lead Notification Emails (Contact / Investors / Ace-Acad Waitlist / AI Solutions)
# ------------------------------------------------------------------------------
# Sign up at https://resend.com, verify wstartech.ng (or use their free
# onboarding@resend.dev sender to start with no domain setup), then paste the
# API key below. Without this set, leads are still safely stored in Sanity —
# only the email notification is skipped.
RESEND_API_KEY=your_resend_api_key_here

# Optional — defaults to Resend's shared sandbox sender until you verify your
# own domain in Resend, e.g. "WSTAR Leads <leads@wstartech.ng>"
# RESEND_FROM_EMAIL=WSTAR Leads <onboarding@resend.dev>

# Optional — where new-lead notification emails are sent. Defaults to ibrahim@wstartech.ng
# LEADS_NOTIFICATION_EMAIL=ibrahim@wstartech.ng
